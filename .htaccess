# Block direct access to sensitive files only
<Files ".env">
    Order allow,deny
    Deny from all
</Files>
<Files "artisan">
    Order allow,deny
    Deny from all
</Files>
<Files "composer.json">
    Order allow,deny
    Deny from all
</Files>
<Files "composer.lock">
    Order allow,deny
    Deny from all
</Files>
