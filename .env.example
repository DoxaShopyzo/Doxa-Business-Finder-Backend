APP_NAME="Doxa Business Finder"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.doxabusinessfinder.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=doxa_business_finder
DB_USERNAME=doxa_user
DB_PASSWORD=your_secure_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis (Optional/Recommended for High Concurrency)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration (SMTP / Postmark / SES)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@doxabusinessfinder.com"
MAIL_FROM_NAME="Doxa Business Finder"

# Google Places API (New)
# Note: Field masks with rating + userRatingCount bill at Enterprise tier ($35/1000 requests)
GOOGLE_PLACES_API_KEY=your_google_cloud_places_api_key
GOOGLE_PLACES_CACHE_HOURS=24
GOOGLE_PLACES_SEARCH_COST=5

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Sanctum Expiration
SANCTUM_EXPIRATION=43200
